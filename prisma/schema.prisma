// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enum for user roles
enum UserRole {
  SUPER_ADMIN
  CHALET_OWNER
  CUSTOMER
}

enum UserAccountStatus {
  Active
  Inactive
  Pending
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  UNPAID
  PENDING
  FULLY_PAID
  PARTIALLY_PAID
  REFUNDED
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  BANK_TRANSFER
  MOBILE_MONEY
}

enum AmenityCategory {
  KITCHEN // e.g., Gas Cooker, Microwave, Fridge
  ENTERTAINMENT // e.g., TV, DSTV
  OUTDOOR // e.g., BBQ Jiko
  BEDROOM // e.g., Ensuite bathroom
  GENERAL // e.g., Parking, WiFi
}

// Enum for verification code types
enum VerificationType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  TWO_FACTOR
}

enum RoomType {
  Double
  Twin
}

enum PropertyType {
  STANDALONE
  DUPLEX_UPPER
  DUPLEX_LOWER
}

model UserAccount {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  firstName          String?
  lastName           String?
  email              String     @unique
  email_verified     DateTime?
  isEmailVerified    Boolean    @default(false)
  password           String
  phoneNumber        String?
  role               UserRole   @default(CUSTOMER)
  permissions        String[]   @default([])
  lastLogin          DateTime?
  lastPasswordChange DateTime?
  loginHistory       DateTime[]
  country            String?

  ownedChalets    Chalet[]        @relation("ChaletOwner")
  wallet          Wallet?
  createdBookings ChaletBooking[] @relation("BookingCreator")

  auditLogs         AuditLog[]
  notifications     Notification[]
  status            UserAccountStatus  @default(Inactive)
  userAgent         String?
  photo             Photo              @relation(fields: [photoId], references: [id])
  photoId           String             @db.Uuid
  verificationCodes VerificationCode[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt()
  deletedAt         DateTime?

  @@index([email])
}

model Photo {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  image      String        @default("https://via.placeholder.com/250")
  name       String        @default("Default Photo")
  isGravatar Boolean       @default(false)
  users      UserAccount[]
  createdAt  DateTime?     @default(now())
  updatedAt  DateTime?     @updatedAt()
  deletedAt  DateTime?
}

model VerificationCode {
  id            String           @id @default(cuid())
  userAccountId String           @db.Uuid
  userAccount   UserAccount      @relation(fields: [userAccountId], references: [id], onDelete: Cascade)
  code          String           @unique
  type          VerificationType
  createdAt     DateTime         @default(now())
  expiresAt     DateTime

  @@index([userAccountId])
  @@index([code])
}

model AuditLog {
  id     String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user   UserAccount @relation(fields: [userId], references: [id])
  userId String      @db.Uuid
}

model Notification {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String
  body          String
  type          String
  referenceId   String
  referenceType String
  user          UserAccount @relation(fields: [userId], references: [id])
  userId        String      @db.Uuid
  isRead        Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt()

  @@index([userId])
}

model CompanyManagement {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  commission Decimal  @default(20.00) @db.Decimal(10, 2) // Default 20%
  // chalets    Chalet[]
  wallet     Wallet?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Add Wallet model for payment distribution
model Wallet {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  balance             Decimal             @default(0) @db.Decimal(10, 2)
  userAccountId       String?             @unique @db.Uuid
  userAccount         UserAccount?        @relation(fields: [userAccountId], references: [id])
  companyManagementId String?             @unique @db.Uuid
  companyManagement   CompanyManagement?  @relation(fields: [companyManagementId], references: [id])
  transactions        WalletTransaction[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
}

model WalletTransaction {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  walletId  String          @db.Uuid
  wallet    Wallet          @relation(fields: [walletId], references: [id])
  amount    Decimal         @db.Decimal(10, 2)
  type      TransactionType
  paymentId String?         @db.Uuid
  payment   Payment?        @relation(fields: [paymentId], references: [id])
  createdAt DateTime        @default(now())
}

// Add SeasonalPrice model
model SeasonalPrice {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chaletId  String   @db.Uuid
  chalet    Chalet   @relation(fields: [chaletId], references: [id])
  startDate DateTime
  endDate   DateTime
  price     Decimal  @db.Decimal(10, 2)
}

// Chalet Model
model Chalet {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  chaletUniqueId String       @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String       @unique
  propertyType   PropertyType @default(STANDALONE)
  description    String?

  basePrice      Decimal         @db.Decimal(10, 2)
  weekendPrice   Decimal?        @db.Decimal(10, 2)
  seasonalPrices SeasonalPrice[]

  // Room Configuration
  roomCount      Int     @default(0) // Keep this for quick access
  isEnsuite      Boolean @default(false)
  totalWashrooms Int     @default(0) // Total number of washrooms in the property

  // Property Details
  totalFloors         Int     @default(1)
  hasUpstairsLounge   Boolean @default(false)
  hasDownstairsLounge Boolean @default(false)
  maxAdults           Int
  maxChildren         Int
  totalSleeps         Int

  isUnderMaintenance   Boolean @default(false)
  reasonForMaintenance String?

  locationName String
  address      String
  coordinates  Json?

  // Relationships
  ownerId String      @db.Uuid
  owner   UserAccount @relation("ChaletOwner", fields: [ownerId], references: [id])
  // companyManagementId String?            @db.Uuid
  // companyManagement   CompanyManagement? @relation(fields: [companyManagementId], references: [id])

  // Relationships
  rooms                  Room[]
  amenities              ChaletAmenity[]
  ChaletUnavailableDates ChaletUnavailableDates[]
  bookings               ChaletBooking[]
  images                 Image[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Room Model
model Room {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomUniqueId String @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  chaletId String @db.Uuid // Ensure the type matches Chalet.id
  chalet   Chalet @relation(fields: [chaletId], references: [id], onDelete: Cascade)

  roomType        RoomType
  floor           Int      @default(1)
  notEnsuite      Boolean  @default(false) // Changed to notEnsuite to flag exceptions
  hasBunkBed      Boolean  @default(false)
  bunkBedCapacity Int? // For rooms with bunk beds
  capacity        Int // Regular bed capacity
  numberOfRooms   Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChaletUnavailableDates {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  chaletId String @db.Uuid
  chalet   Chalet @relation(fields: [chaletId], references: [id], onDelete: Cascade)

  date DateTime

  @@unique([chaletId, date])
}

model Image {
  id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  url    String
  alt    String?
  key    String?
  label  String?
  isMain Boolean @default(false)

  chaletId String @db.Uuid
  chalet   Chalet @relation(fields: [chaletId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model ChaletAmenity {
  id          Int             @id @default(autoincrement())
  name        String          @unique // Add unique constraint
  description String?
  category    AmenityCategory @default(GENERAL)
  icon        String? // For UI display

  chalets Chalet[]

  createdAt DateTime @default(now())

  @@index([name])
  @@index([category])
}

model ChaletBooking {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingReference String?   @unique 
  chaletId         String   @db.Uuid
  chalet           Chalet   @relation(fields: [chaletId], references: [id], onDelete: Cascade)
  checkIn          DateTime
  checkOut         DateTime
  numberOfAdults   Int
  numberOfChildren Int
  totalGuests      Int
  totalCost        Decimal  @db.Decimal(10, 2)
  customerId       String   @db.Uuid
  customer         Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdById String?      @db.Uuid
  createdBy   UserAccount? @relation("BookingCreator", fields: [createdById], references: [id])

  status       BookingStatus  @default(PENDING)
  payments     Payment[]
  bookingDates BookingDate[] // Relation to booking dates 
  bookingAddOn BookingAddon[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([chaletId])
  @@index([checkIn, checkOut])
}

model BookingDate {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date      DateTime?
  bookingId String        @db.Uuid
  booking   ChaletBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, date]) // Ensure no duplicate dates for a booking
  @@index([date]) // Index for faster date lookups
}

model Payment {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  uniqueId String @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  bookingId String        @db.Uuid
  booking   ChaletBooking @relation(fields: [bookingId], references: [id])

  amount Decimal       @db.Decimal(10, 2)
  status PaymentStatus @default(UNPAID)
  method PaymentMethod @default(CASH)

  transactionId String?
  receiptNumber String?

  walletTransactions WalletTransaction[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model Customer {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  uniqueId String @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  firstName      String?
  lastName       String?
  fullName       String?
  addresss       String?
  email          String?
  phone          String?
  nationality    String?
  passportNumber String?

  bookings ChaletBooking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AddOn {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  uniqueId String @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  name        String
  description String?
  price       Decimal @db.Decimal(10, 2)

  bookingAddons BookingAddon[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BookingAddon {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  uniqueId String @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  bookingId String        @db.Uuid
  booking   ChaletBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  addOnId String @db.Uuid
  addOn   AddOn  @relation(fields: [addOnId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bookingId, addOnId])
}

model ChaletRules {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  uniqueId String @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  title       String
  description String?
  icon        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
