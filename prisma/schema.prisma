// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enum for user roles
enum UserRole {
  SUPER_ADMIN
  CHALET_OWNER
  CUSTOMER
}

enum UserAccountStatus {
  Active
  Inactive
  Pending
}

// Enum for verification code types
enum VerificationType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  TWO_FACTOR
}

model UserAccount {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  firstName          String?
  lastName           String?
  email              String             @unique
  email_verified     DateTime?
  password           String
  phoneNumber        String?
  role               UserRole           @default(CUSTOMER)
  permissions        String[]           @default([])
  lastLogin          DateTime?
  lastPasswordChange DateTime?
  loginHistory       DateTime[]
  country            String?
  auditLogs          AuditLog[]
  notifications      Notification[]
  status             UserAccountStatus  @default(Inactive)
  userAgent          String?
  photo              Photo              @relation(fields: [photoId], references: [id])
  photoId            String             @db.Uuid
  verificationCodes  VerificationCode[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt()
  deletedAt          DateTime?

  @@index([email])
}

model Photo {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  image      String        @default("https://via.placeholder.com/250")
  name       String        @default("Default Photo")
  isGravatar Boolean       @default(false)
  users      UserAccount[]
  createdAt  DateTime?     @default(now())
  updatedAt  DateTime?     @updatedAt()
  deletedAt  DateTime?
}

model VerificationCode {
  id            String           @id @default(cuid())
  userAccountId String           @db.Uuid
  userAccount   UserAccount      @relation(fields: [userAccountId], references: [id], onDelete: Cascade)
  code          String           @unique
  type          VerificationType
  createdAt     DateTime         @default(now())
  expiresAt     DateTime

  @@index([userAccountId])
  @@index([code])
}

model AuditLog {
  id     String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user   UserAccount @relation(fields: [userId], references: [id])
  userId String      @db.Uuid
}

model Notification {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String
  body          String
  type          String
  referenceId   String
  referenceType String
  user          UserAccount @relation(fields: [userId], references: [id])
  userId        String      @db.Uuid
  isRead        Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt()

  @@index([userId])
}
