{
  "name": "chalet-api",
  "version": "0.0.0",
  "description": "api for managing chalets and booking",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsc --project './tsconfig.build.json' --watch & NODE_ENV=development nodemon --trace-warnings ./dist/index.js",
    "build": "tsc --project './tsconfig.build.json'",
    "start": "npm run build && NODE_ENV=production node --trace-warnings ./dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamobrand/chalet-api.git"
  },
