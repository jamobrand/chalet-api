{
  "name": "chalet-api",
  "version": "0.1.0",
  "description": "api for managing chalets and booking",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsc --project './tsconfig.build.json' --watch & NODE_ENV=development nodemon --trace-warnings ./dist/index.js",
    "build": "tsc --project './tsconfig.build.json'",
    "start": "npm run build && NODE_ENV=production node --trace-warnings ./dist/index.js",
    "prepare": "husky",
    "lint": "eslint src/**/*.ts __test__/**/*.test.ts",
    "lint:fix": "eslint --fix --ext .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:prod": "prisma migrate deploy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamobrand/chalet-api.git"
  },
  "author": "James Kariuki",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/jamobrand/chalet-api/issues"
  },
  "homepage": "https://github.com/jamobrand/chalet-api#readme",
  "dependencies": {
    "@prisma/client": "^5.19.0",
    "@types/express-serve-static-core": "^4.19.5",
    "argon2": "^0.40.3",
    "body-parser": "^1.20.2",
    "bullmq": "^5.34.5",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "http-errors": "^2.0.0",
    "http-status": "^1.7.4",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "path": "^0.12.7",
    "utility-types": "^3.11.0",
    "uuid": "^10.0.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xss": "^1.0.14",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.11",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-security": "^3.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.9",
    "nodemon": "^3.1.9",
    "prettier": "^3.3.3",
    "prisma": "^5.19.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "npx prettier --write",
      "npx eslint --fix"
    ]
  }
}
